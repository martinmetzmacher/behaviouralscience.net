      "URL": "http://seriousmarketing.de",
      "avatar_URL": "https://2.gravatar.com/avatar/2edab6fe7bba73514eb616f4b46999ce1a63627320521b39135e34d034f9b634?s=96&d=https%3A%2F%2F2.gravatar.com%2Favatar%2Fad516503a11cd5ca435acc9bb6523536%3Fs%3D96&r=G",
      "profile_URL": "https://gravatar.com/martinglanert",
